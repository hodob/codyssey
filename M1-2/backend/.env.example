# 복사해서 .env 로 사용 (.env 는 git 에 올리지 않는다)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
# OpenAI 호환 프록시를 쓸 때만 지정 (비우면 OpenAI 공식 주소)
OPENAI_BASE_URL=
OPENAI_MAX_TOKENS=1500
# 서비스 계정 키: JSON 문자열 전체 또는 키 파일 경로 (둘 중 하나)
FIREBASE_SERVICE_ACCOUNT_JSON=./serviceAccountKey.json
# CORS 허용 도메인 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
