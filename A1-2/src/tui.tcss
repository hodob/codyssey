/*
 * 고정 여행 팔레트
 * 아이보리 바탕 + 잉크 네이비 본문 + 청록 중심 강조 + 앰버/코랄 보조 강조.
 * 장소에 따라 색을 바꾸지 않아 화면 간 브랜드 인상을 유지한다.
 */
Screen { background: #F6F1E8; color: #1F2937; }
#heading { height: 3; padding: 1 2; background: #FFFDF8; color: #1F2937; text-style: bold; content-align: center middle; }
#tabs { height: 5; padding: 1 1 0 1; align: center middle; background: #E5F0EF; border-bottom: solid #147D8C; }
#tabs Button { height: 3; min-width: 14; margin: 0; padding: 1 0; border: none; background: #E5F0EF; color: #1F2937; text-style: bold; content-align: center middle; }
#tabs Button:hover { background: #CBE4E1; color: #102A32; }
#tabs Button.tab-selected { background: #0F6572; color: #FFFFFF; text-style: bold; }
#pages { height: 1fr; }
ReadingPane { padding: 2 3; height: 1fr; }
ReadingPane:focus { border-left: solid #147D8C; }
ReadingPane Static { height: auto; max-width: 100; }
#recommend-layout { width: 100%; height: auto; align: center top; }
#recommend-copy { width: 76; max-width: 100%; min-width: 36; height: auto; padding: 0 1; }
#recommend-hero { width: 1fr; height: auto; min-height: 11; padding: 1 2; margin-bottom: 1; background: #FFFDF8; border-bottom: solid #D4BA76; align: center middle; }
#recommend-kicker { width: 1fr; color: #667085; height: auto; content-align: center middle; }
#recommend-city-name { width: 1fr; color: #E59F3A; text-style: bold; height: 3; content-align: center middle; margin-top: 1; }
#recommend-city-divider { width: 1fr; color: #D4BA76; height: auto; content-align: center middle; }
#recommend-subtitle { width: 1fr; color: #1F2937; height: auto; content-align: center middle; }
.recommend-section { display: none; width: 1fr; height: auto; margin-top: 1; padding: 1 2; background: #FFFDF8; border-top: solid #D7E0DF; }
.recommend-section-title { color: #147D8C; text-style: bold; height: auto; margin-bottom: 1; }
#recommend-reason-body, #recommend-weather-body, #recommend-events-body { width: 1fr; height: auto; }
#recommend-notice { width: 1fr; height: auto; margin-top: 2; padding: 0 1; color: #667085; content-align: center middle; }
#places { padding: 1 2; }
#schedule { align: center top; }
#schedule-body { width: 88; max-width: 100%; height: auto; color: #1F2937; }
#places-state { height: auto; margin-bottom: 1; color: #1F2937; text-style: bold; }
#place-list { height: 1fr; background: #FFFDF8; color: #1F2937; border: none; }
OptionList > .option-list--option { padding: 0 1; background: #FFFDF8; color: #1F2937; }
OptionList > .option-list--option-highlighted { background: #BFE1E4; color: #102A32; text-style: bold; }
#status { height: auto; min-height: 1; max-height: 3; background: #E9F3F1; color: #147D8C; padding: 0 1; }
Footer { background: #FFFDF8; color: #1F2937; }
#context { height: auto; max-height: 2; background: #FFFDF8; color: #1F2937; padding: 0 1; }
Button { margin: 1 1 0 0; min-width: 16; background: #147D8C; color: #FFFFFF; border: none; }
#map-button:hover, #back-button:hover, #close-records:hover, #continue:hover { background: #0F6572; }
Records, ConfirmQuit { align: center middle; background: #1F2937 65%; }
#dialog { width: 90%; height: 85%; border: solid #147D8C; background: #FFFDF8; padding: 1 2; }
#dialog ReadingPane { padding: 1; }
.dialog-title { height: auto; margin-bottom: 1; color: #147D8C; text-style: bold; }
#quit-dialog { width: 85%; max-width: 76; height: auto; max-height: 95%; overflow-y: auto; border: solid #147D8C; background: #FFFDF8; padding: 1 2; }
